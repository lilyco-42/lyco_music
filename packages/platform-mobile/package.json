{
  "name": "@lxmn/platform-mobile",
  "version": "0.2.11",
  "description": "React Native 平台实现 — 零原生模块，纯 JS 加密",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@lxmn/core": "workspace:*"
  },
  "peerDependencies": {
    "react-native": ">=0.70",
    "react-native-background-timer": ">=2.4"
  },
  "peerDependenciesMeta": {
    "react-native-background-timer": {
      "optional": true
    }
  },
  "license": "Apache-2.0"
}
