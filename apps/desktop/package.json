{
  "name": "@lxmn/app-desktop",
  "version": "0.2.36",
  "private": true,
  "description": "Lyco Music 桌面端 — 网易云风格 UI（Vue3 + Electron）",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "preview": "vite preview",
    "electron:dev": "cross-env LXMN_DEV_URL=http://localhost:5173 electron .",
    "electron:build": "pnpm build && electron-builder --publish never",
    "probe:download": "electron scripts/probe-download.cjs",
    "shot": "electron scripts/shot.cjs"
  },
  "dependencies": {
    "@lxmn/core": "workspace:*",
    "@lxmn/tokens": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-vue-next": "^0.469.0",
    "reka-ui": "^2.5.0",
    "tailwind-merge": "^2.6.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "@vitejs/plugin-vue": "^5.2.4",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.9.3",
    "vite": "^6.3.5",
    "vue-tsc": "^2.2.10",
    "cross-env": "^7.0.3",
    "electron": "33.4.11",
    "electron-builder": "^25.1.8"
  },
  "author": "lain42 <lilyco42@lain42.top>",
  "license": "Apache-2.0",
  "main": "electron/main.cjs"
